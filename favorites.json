["\u041a\u043b\u0443\u0431\u043d\u0438\u043a\u0430 \u0441\u0443\u0431\u043b\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f", "\u0427\u0430\u0439 \"\u0414\u044b\u043d\u044f \u041a\u043b\u0443\u0431\u043d\u0438\u043a\u0430\"", "\u0447\u0430\u0439 \"\u0434\u044b\u043d\u044f \u043a\u043b\u0443\u0431\u043d\u0438\u043a\u0430\"", "\u0442\u0440\u0430\u0432\u044f\u043d\u043e\u0439 \u0441\u0431\u043e\u0440 \"\u043b\u0430\u0432\u0430\u043d\u0434\u0430 \u0446\u0432\u0435\u0442\u044b\"", "\u043a\u0430\u043b\u0438\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0438\u0435 \u043a\u043e\u043d\u0444\u0435\u0442\u044b \u00abkonigsberg\u00bb \u0441\u043b\u0438\u0432\u043e\u0447\u043d\u044b\u0435, 110 \u0433\u0440", "\u0444\u0440\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u0447\u0430\u0439 \"\u0433\u043b\u0438\u043d\u0442\u0432\u0435\u0439\u043d\"", "\u0444\u0440\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u0447\u0430\u0439 \"\u043c\u043e\u0445\u0438\u0442\u043e\"", "\u0443\u043a\u0441\u0443\u0441 \u044f\u0431\u043b\u043e\u0447\u043d\u044b\u0439 \u0441 \u0431\u0430\u0437\u0438\u043b\u0438\u043a\u043e\u043c", "\u0442\u0440\u0430\u0432\u044f\u043d\u043e\u0439 \u0441\u0431\u043e\u0440 \"\u0440\u043e\u043c\u0430\u0448\u043a\u0430 \u0433\u043e\u043b\u043e\u0432\u043a\u0438\"", "\u0444\u0440\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u0447\u0430\u0439 \"\u0440\u0435\u0446\u0435\u043f\u0442 \u0434\u043e\u043b\u0433\u043e\u043b\u0435\u0442\u0438\u044f\"", "\u0434\u0440\u0430\u0436\u0435 \"\u043c\u0438\u043d\u0434\u0430\u043b\u044c \u0432 \u0431\u0435\u043b\u043e\u043c \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u0435\", 150 \u0433\u0440"]